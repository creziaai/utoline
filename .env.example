# Utoline environment configuration
# Copy this file to .env and fill in values before building for production.
# All values here are read at BUILD TIME by scripts/build.js and baked into
# dist/assets/js/config.js as plain client-side config. Do not put secret
# API keys here — GA Measurement IDs and AdSense IDs are public by design.

# Canonical site URL (no trailing slash). Used for canonical tags, sitemap.xml,
# robots.txt and Open Graph URLs.
# Required before production deploy: set the real origin, e.g. https://your-domain.tld
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID. Leave empty to keep analytics fully disabled.
NEXT_PUBLIC_GA_ID=

# AdSense — disabled by default. Set to "true" only once you have a real,
# approved publisher ID and slot IDs below. When false (or unset), no ad
# script or ad markup is ever emitted.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
